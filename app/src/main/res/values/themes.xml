<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Notscape" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">#1B3A4B</item>
    </style>
    <style name="Theme.Notscape.Player" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
    <style name="Theme.Notscape.CastButton" parent="Theme.AppCompat">
        <!-- Beta.56 MediaRouteButton crash fix (standalone redo of
             the beta.52 fix lost in the beta.53 retro revert):
             MediaRouterThemeHelper (mediarouter 1.7.0) resolves
             AppCompat color attributes inside the button
             constructor to pick the controller color; the app's
             platform Material themes define no AppCompat colors,
             so the value resolved to #0 and
             ColorUtils.calculateContrast threw "background can
             not be translucent: #0". Opaque dark pins keep the
             button and its chooser/controller dialogs dark,
             matching the dark player chrome. -->
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">@android:color/white</item>
    </style>
</resources>
